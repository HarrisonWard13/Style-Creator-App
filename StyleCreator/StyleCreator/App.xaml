<Application x:Class="StyleCreator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:StyleCreator.Tools"
             xmlns:local="clr-namespace:StyleCreator"
             StartupUri="MainWindow.xaml">

  <Application.Resources>
    <ResourceDictionary>
      <converters:StyleCreatorCornerRadiusConverter x:Key="StyleCreatorCornerRadiusConverter " />
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/Colors.xaml" />
        <ResourceDictionary Source="Styles/Base.xaml" />
        <ResourceDictionary Source="Styles/Button.xaml" />
        <ResourceDictionary Source="Styles/TextBox.xaml" />
        <ResourceDictionary Source="Styles/ToggleButton.xaml" />
        <ResourceDictionary Source="Styles/ComboBox.xaml" />
        <ResourceDictionary Source="Styles/CheckBox.xaml" />
        <ResourceDictionary Source="Styles/RadioButton.xaml" />
        <ResourceDictionary Source="Styles/PasswordBox.xaml" />
        <ResourceDictionary Source="Styles/ComboBoxItem.xaml" />
        <ResourceDictionary Source="Styles/ListBoxItem.xaml" />
        <ResourceDictionary Source="Styles/ListBox.xaml" />
        <ResourceDictionary Source="Styles/ListView.xaml" />
        <ResourceDictionary Source="Styles/ListViewItem.xaml" />
        <ResourceDictionary Source="Styles/GridViewColumnHeader.xaml" />
        <ResourceDictionary Source="Styles/ScrollBar.xaml" />
        <ResourceDictionary Source="Styles/TabControl.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
