<UserControl x:Class="StyleCreator.Views.ColorEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="clr-namespace:StyleCreator.Tools"
             x:Name="Root">

  <UserControl.Resources>
    <tools:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <tools:ColorToBrushConverter x:Key="ColorToBrushConverter" />

    <Style x:Key="Expander" TargetType="ToggleButton">
      <Setter Property="Height" Value="15" />
      <Setter Property="Content" Value="&gt;" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource ControlCornerRadius}">

              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>

            <ControlTemplate.Triggers>

              <!--  Toggled  -->
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                <Setter Property="Content" Value="V" />
              </Trigger>

            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>


  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0"
                Margin="0,4"
                Orientation="Horizontal">
      <ToggleButton Width="15"
                    Height="15"
                    VerticalAlignment="Center"
                    IsChecked="{Binding SlidersVisible, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Width="110"
                 VerticalAlignment="Center"
                 Text="{Binding Label, ElementName=Root}" />

      <Rectangle Width="24"
                 Height="24"
                 Margin="0,0,8,0"
                 Fill="{Binding Color, ElementName=Root, Converter={StaticResource ColorToBrushConverter}}"
                 Stroke="{DynamicResource BorderBrush}" />

      <TextBox Width="90" Text="{Binding HexValue, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="10*" />
        <ColumnDefinition Width="40*" />
      </Grid.ColumnDefinitions>
      <!--  RValue  -->
      <TextBlock Grid.Row="0"
                 Grid.Column="0"
                 Width="24"
                 VerticalAlignment="Center"
                 Text="R:"
                 Visibility="{Binding SlidersVisible, ElementName=Root, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVisibilityConverter}}" />
      <Slider Grid.Row="0"
              Grid.Column="1"
              Maximum="255"
              Minimum="0"
              Visibility="{Binding SlidersVisible, ElementName=Root, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVisibilityConverter}}"
              Value="{Binding Red, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" />
      <!--  GValue  -->
      <TextBlock Grid.Row="1"
                 Grid.Column="0"
                 Width="24"
                 VerticalAlignment="Center"
                 Text="G:"
                 Visibility="{Binding SlidersVisible, ElementName=Root, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVisibilityConverter}}" />
      <Slider Grid.Row="1"
              Grid.Column="1"
              Maximum="255"
              Minimum="0"
              Visibility="{Binding SlidersVisible, ElementName=Root, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVisibilityConverter}}"
              Value="{Binding Green, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" />
      <!--  BValue  -->
      <TextBlock Grid.Row="2"
                 Grid.Column="0"
                 Width="24"
                 VerticalAlignment="Center"
                 Text="B:"
                 Visibility="{Binding SlidersVisible, ElementName=Root, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVisibilityConverter}}" />
      <Slider Grid.Row="2"
              Grid.Column="1"
              Maximum="255"
              Minimum="0"
              Visibility="{Binding SlidersVisible, ElementName=Root, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolToVisibilityConverter}}"
              Value="{Binding Blue, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" />
    </Grid>
  </Grid>
</UserControl>
